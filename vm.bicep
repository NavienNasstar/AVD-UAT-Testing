// Resource-group-scoped module: one VM + NIC + OS disk, optionally joined (domain, Entra ID or none),
// registered to an EXISTING AVD host pool, with the Azure Monitor Agent and a data collection rule.
// Called by vms.bicep once per VM.
// Practice standards that are NOT negotiable per customer are fixed in the 'Fixed standards' block below.
targetScope = 'resourceGroup'

param name string
param computerName string
param nicName string
param osDiskName string
param location string
param vmSize string
@description('Availability zone number (1-3). 0 = no zone.')
param zone int
param imageReference string
param subnetId string

@secure()
param adminUsername string

@secure()
param adminPassword string

@description('Create the VM with the TrustedLaunch security type (secure boot + vTPM). Required when the image only supports TrustedLaunch.')
param trustedLaunch bool

@description('Enable encryption at host. Requires the Microsoft.Compute/EncryptionAtHost feature to be registered on the subscription.')
param encryptionAtHost bool

@description('How the VM is joined: domain = Active Directory, entra = Microsoft Entra ID, none = not joined.')
@allowed([
  'domain'
  'entra'
  'none'
])
param joinType string

@description('Domain name, e.g. contoso.com. Only used when joinType is domain.')
param domainName string = ''

@description('OU path for the computer account, e.g. OU=AVD,DC=contoso,DC=com. Only used when joinType is domain.')
param ouPath string = ''

@description('Account used to join the domain, e.g. svc-join@contoso.com. Only used when joinType is domain.')
param domainUsername string = ''

@secure()
param domainPassword string = ''

@description('Name of the existing AVD host pool, e.g. hp-acme-uks-prod.')
param hostpoolName string

@description('Host pool registration token (short-lived). Generated by the pipeline just before deployment.')
@secure()
param hostpoolToken string

@description('Install the Azure Monitor Agent and associate the data collection rule.')
param enableAma bool = false

@description('Install the Azure Policy guest configuration extension (AzurePolicyforWindows).')
param enableGuestConfig bool = false

@description('Install the Microsoft Defender for Endpoint extension (MDE.Windows).')
param enableDefender bool = false

@description('Resource ID of the data collection rule (can be in another subscription). Used when enableAma is true.')
param dcrId string = ''

param tags object = {}

// ---------------------------------------------------------------------------
// Fixed standards (same for every customer)
// ---------------------------------------------------------------------------
var osDiskSizeGB = 128
var osDiskStorageAccountType = 'Premium_LRS'
var avdAgentModulesUrl = 'https://wvdportalstorageblob.blob.${environment().suffixes.storage}/galleryartifacts/Configuration_09-08-2022.zip'

resource nic 'Microsoft.Network/networkInterfaces@2024-05-01' = {
  name: nicName
  location: location
  tags: tags
  properties: {
    ipConfigurations: [
      {
        name: 'ipconfig01'
        properties: {
          privateIPAllocationMethod: 'Dynamic'
          subnet: {
            id: subnetId
          }
        }
      }
    ]
  }
}

resource vm 'Microsoft.Compute/virtualMachines@2024-07-01' = {
  name: name
  location: location
  tags: tags
  zones: zone == 0 ? null : [
    string(zone)
  ]
  identity: {
    type: 'SystemAssigned'
  }
  properties: {
    hardwareProfile: {
      vmSize: vmSize
    }
    // Only sent when enabled: Azure rejects encryptionAtHost (even as false) on
    // subscriptions where the EncryptionAtHost feature is not registered.
    securityProfile: union(
      trustedLaunch ? {
        securityType: 'TrustedLaunch'
        uefiSettings: {
          secureBootEnabled: true
          vTpmEnabled: true
        }
      } : {},
      encryptionAtHost ? {
        encryptionAtHost: true
      } : {}
    )
    storageProfile: {
      imageReference: {
        id: imageReference
      }
      osDisk: {
        name: osDiskName
        createOption: 'FromImage'
        caching: 'ReadWrite'
        diskSizeGB: osDiskSizeGB
        deleteOption: 'Delete'
        managedDisk: {
          storageAccountType: osDiskStorageAccountType
        }
      }
    }
    osProfile: {
      computerName: computerName
      adminUsername: adminUsername
      adminPassword: adminPassword
      windowsConfiguration: {
        provisionVMAgent: true
        enableAutomaticUpdates: true
      }
    }
    networkProfile: {
      networkInterfaces: [
        {
          id: nic.id
          properties: {
            deleteOption: 'Delete'
          }
        }
      ]
    }
  }
}

// ---- Domain join (classic Active Directory), only when joinType is domain ----
resource domainJoinExtension 'Microsoft.Compute/virtualMachines/extensions@2024-07-01' = if (joinType == 'domain') {
  parent: vm
  name: 'JsonADDomainExtension'
  location: location
  tags: tags
  properties: {
    publisher: 'Microsoft.Compute'
    type: 'JsonADDomainExtension'
    typeHandlerVersion: '1.3'
    autoUpgradeMinorVersion: true
    settings: {
      name: domainName
      ouPath: ouPath
      user: domainUsername
      restart: 'true'
      options: '3'
    }
    protectedSettings: {
      password: domainPassword
    }
  }
}

// ---- Microsoft Entra ID join, only when joinType is entra ----
resource aadJoinExtension 'Microsoft.Compute/virtualMachines/extensions@2024-07-01' = if (joinType == 'entra') {
  parent: vm
  name: 'AADLoginForWindows'
  location: location
  tags: tags
  properties: {
    publisher: 'Microsoft.Azure.ActiveDirectory'
    type: 'AADLoginForWindows'
    typeHandlerVersion: '2.0'
    autoUpgradeMinorVersion: true
    settings: {}
  }
}

// ---- AVD host pool registration (runs after the join extension finishes, if any) ----
resource hostPoolRegistration 'Microsoft.Compute/virtualMachines/extensions@2024-07-01' = {
  parent: vm
  name: 'HostPoolRegistration'
  location: location
  tags: tags
  dependsOn: [
    domainJoinExtension
    aadJoinExtension
  ]
  properties: {
    publisher: 'Microsoft.Powershell'
    type: 'DSC'
    typeHandlerVersion: '2.77'
    autoUpgradeMinorVersion: true
    settings: {
      modulesUrl: avdAgentModulesUrl
      configurationFunction: 'Configuration.ps1\\AddSessionHost'
      properties: {
        hostPoolName: hostpoolName
        registrationInfoToken: hostpoolToken
        aadJoin: joinType == 'entra'
      }
    }
  }
}

// ---- Azure Monitor Agent + data collection rule association (optional) ----
resource amaExtension 'Microsoft.Compute/virtualMachines/extensions@2024-07-01' = if (enableAma) {
  parent: vm
  name: 'AzureMonitorWindowsAgent'
  location: location
  tags: tags
  properties: {
    publisher: 'Microsoft.Azure.Monitor'
    type: 'AzureMonitorWindowsAgent'
    typeHandlerVersion: '1.0'
    autoUpgradeMinorVersion: true
    enableAutomaticUpgrade: true
  }
}

resource dcrAssociation 'Microsoft.Insights/dataCollectionRuleAssociations@2022-06-01' = if (enableAma) {
  name: 'SendMetricsToLAW'
  scope: vm
  properties: {
    dataCollectionRuleId: dcrId
  }
  dependsOn: [
    amaExtension
  ]
}

// ---- Azure Policy guest configuration (shows as AzurePolicyforWindows). Needs the VM system-assigned identity, which is enabled above. ----
resource guestConfigExtension 'Microsoft.Compute/virtualMachines/extensions@2024-07-01' = if (enableGuestConfig) {
  parent: vm
  name: 'AzurePolicyforWindows'
  location: location
  tags: tags
  dependsOn: [
    hostPoolRegistration
  ]
  properties: {
    publisher: 'Microsoft.GuestConfiguration'
    type: 'ConfigurationforWindows'
    typeHandlerVersion: '1.0'
    autoUpgradeMinorVersion: true
    enableAutomaticUpgrade: true
  }
}

// ---- Microsoft Defender for Endpoint (MDE.Windows) ----
resource defenderExtension 'Microsoft.Compute/virtualMachines/extensions@2024-07-01' = if (enableDefender) {
  parent: vm
  name: 'MDE.Windows'
  location: location
  tags: tags
  dependsOn: [
    hostPoolRegistration
  ]
  properties: {
    publisher: 'Microsoft.Azure.AzureDefenderForServers'
    type: 'MDE.Windows'
    typeHandlerVersion: '1.0'
    autoUpgradeMinorVersion: true
    settings: {
      azureResourceId: vm.id
      forceReOnboarding: false
      vNextEnabled: true
    }
  }
}

output vmId string = vm.id
